<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#403B82F6" />
            <stroke android:width="2dp" android:color="#3B82F6" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#603B82F6" />
            <stroke android:width="1dp" android:color="#3B82F6" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#66111827" />
            <stroke android:width="1dp" android:color="#2B374E" />
        </shape>
    </item>
</selector>
