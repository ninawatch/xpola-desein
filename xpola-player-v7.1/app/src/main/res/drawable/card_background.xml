<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state for Android TV Remote / D-pad -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2000C6FF" />
            <corners android:radius="10dp" />
            <stroke
                android:width="2dp"
                android:color="#00C6FF" />
        </shape>
    </item>

    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3000C6FF" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#00C6FF" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#131927" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#222B3E" />
        </shape>
    </item>
</selector>
