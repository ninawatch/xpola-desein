<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state for Android TV Remote / D-pad -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A3B82F6" />
            <corners android:radius="10dp" />
            <stroke
                android:width="2dp"
                android:color="#3B82F6" />
        </shape>
    </item>

    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#263B82F6" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#3B82F6" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#121824" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#1E2B3C" />
        </shape>
    </item>
</selector>
