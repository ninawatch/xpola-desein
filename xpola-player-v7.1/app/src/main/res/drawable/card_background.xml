<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state (TV Remote or Keyboard navigation) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#266366F1" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2dp"
                android:color="#00E5FF" />
        </shape>
    </item>

    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#336366F1" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#6366F1" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#161C24" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#212B36" />
        </shape>
    </item>
</selector>
