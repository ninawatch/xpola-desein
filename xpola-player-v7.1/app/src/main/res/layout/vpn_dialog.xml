<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_glass"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:id="@+id/remove_app_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/app_name"
            android:focusable="false"
            android:src="@drawable/ic_vpn"
            app:tint="@color/brand_accent" />

        <TextView
            android:id="@+id/app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif-bold"
            android:text="@string/vpn"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/app_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@string/disable_vpn"
            android:textColor="@color/secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/closer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/button_gradient_background"
            android:fontFamily="sans-serif-bold"
            android:text="@string/exit"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
