<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/body_gradient"
    android:gravity="center_horizontal"
    android:padding="20dp">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- App Icon -->
        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/splash_icon"
            android:layout_marginBottom="20dp"/>

        <!-- App Name -->
        <TextView
            android:id="@+id/app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-condensed"/>

        <!-- App Version -->
        <TextView
            android:id="@+id/app_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Version 2.5.1"
            android:textSize="16sp"
            android:textColor="#E0E0E0"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif"/>

        <!-- Update Status -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/update_status_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_check"
                android:tint="#4CAF50"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/new_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Up to date"
                android:textSize="15sp"
                android:textColor="#4CAF50"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <!-- Update Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="Update Now"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.Button"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_download"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            android:backgroundTint="#2196F3"/>

    </LinearLayout>

    <!-- Bottom Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Restart Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/restart_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Restart"
            android:textSize="16sp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:cornerRadius="26dp"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:icon="@drawable/ic_restart"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"/>

        <!-- Clear Resume Data Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clear_resume_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Clear Resume Data"
            android:textSize="16sp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:cornerRadius="26dp"
            app:strokeColor="#FF5252"
            app:strokeWidth="1dp"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            android:textColor="#FF5252"
            android:layout_marginBottom="12dp"/>

        <!-- Close Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/close_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Close"
            android:textSize="16sp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            app:icon="@drawable/ic_close"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            android:textColor="#B0BEC5"/>

    </LinearLayout>

</LinearLayout>