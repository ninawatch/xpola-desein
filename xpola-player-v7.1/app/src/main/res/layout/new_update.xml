<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_glass"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/update_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:paddingBottom="8dp"
        android:singleLine="true"
        android:text="@string/new_update_title"
        android:textColor="@color/white"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/update_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="4dp"
        android:paddingBottom="20dp"
        android:text="message"
        android:textColor="@color/secondary"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dialog_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="sans-serif-medium"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/new_update_cancel_btn"
            android:textColor="@color/secondary" />

        <Button
            android:id="@+id/dialog_down"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/button_gradient_background"
            android:fontFamily="sans-serif-bold"
            android:focusable="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/new_update_down_btn"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
